# Copy to .env (never committed) to override the docker-compose.yml defaults.
# Local development needs none of these. In production every secret is mandatory: with
# ESFAKE_ENV=production the services refuse to start while any value contains "dev-insecure".

ESFAKE_ENV=development

# Postgres superuser; used only by the image and the bootstrap script.
POSTGRES_PASSWORD=
# Roles created on first start by backend/migrations/bootstrap (ADR-0002 §6).
ESFAKE_OWNER_PASSWORD=
ESFAKE_APP_PASSWORD=

# Shared secret between the API's internal listener, the workers and the CLI.
ESFAKE_INTERNAL_SECRET=

# Comma-separated addresses of reverse proxies allowed to set X-Forwarded-For. Empty: none.
ESFAKE_TRUSTED_PROXIES=
